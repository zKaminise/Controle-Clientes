{
  "name": "controle-clientes",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:verify": "tsx scripts/verify-production-database.ts",
    "crm:smoke": "tsx scripts/smoke-crm.ts",
    "db:clean-qa": "tsx scripts/clean-production-qa.ts",
    "db:normalize-clients": "tsx --env-file-if-exists=.env.local scripts/normalize-existing-clients.ts",
    "db:verify-ux": "tsx --env-file-if-exists=.env.local scripts/verify-crm-ux.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "agent:create-token": "tsx --env-file-if-exists=.env.local scripts/create-agent-token.ts",
    "agent:list": "tsx --env-file-if-exists=.env.local scripts/list-agent-integrations.ts",
    "agent:revoke": "tsx --env-file-if-exists=.env.local scripts/revoke-agent-integration.ts",
    "agent:test-api": "tsx --env-file-if-exists=.env.local scripts/test-agent-api.ts",
    "agent:test-security": "tsx --env-file-if-exists=.env.local scripts/test-agent-api-security.ts",
    "agent:test-writes": "tsx --env-file-if-exists=.env.local scripts/test-agent-writes.ts",
    "agent:verify-queries": "tsx --env-file-if-exists=.env.local scripts/verify-agent-queries.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@better-auth/cimd": "^1.7.3",
    "@better-auth/mcp": "^1.7.3",
    "@better-auth/oauth-provider": "^1.7.3",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@neondatabase/serverless": "1.1.0",
    "@shadcn/react": "0.3.0",
    "better-auth": "^1.7.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "next": "16.3.3",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "resend": "6.25.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "oxfmt": "0.61.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "type": "module"
}
