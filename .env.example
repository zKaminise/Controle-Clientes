# Database — use a pooled Neon connection string
DATABASE_URL=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=America/Sao_Paulo

# Better Auth — generate a high-entropy value with at least 32 characters
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Vercel Cron — random value with at least 16 characters
CRON_SECRET=

# Resend — optional until e-mail sending is enabled
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Gabriel Misao

# One-time administrator bootstrap only. Remove after `npm run create-admin`.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
