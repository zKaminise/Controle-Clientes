# Database — use a pooled Neon connection string
DATABASE_URL=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=America/Sao_Paulo

# Better Auth — generate a high-entropy value with at least 32 characters
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Vercel Cron — independent random value generated from at least 32 random bytes
CRON_SECRET=

# Resend — optional until e-mail sending is enabled
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Gabriel Misao

# One-time administrator bootstrap only. Remove after `npm run create-admin`.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Read-only Agent API. Defaults to ADMIN_EMAIL and NEXT_PUBLIC_APP_URL when omitted.
AGENT_ALLOWED_ADMIN_EMAIL=gabriel.misao08@gmail.com
AGENT_API_AUDIENCE=http://localhost:3000/api/agent/v1

# Local read-only consumer. Never commit a real token.
AGENT_API_BASE_URL=https://clientes.gabrielmisao.com.br/api/agent/v1
AGENT_API_TOKEN=
